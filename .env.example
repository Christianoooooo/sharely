# Server
PORT=3000

# Host address Docker publishes the app port on.
# Keep 127.0.0.1 when the reverse proxy runs directly on the host (e.g. nginx).
# Use 0.0.0.0 only behind an external firewall that blocks the port from the
# internet (e.g. Hetzner Cloud Firewall) or without a proxy. Docker bypasses
# host firewalls like ufw. A proxy or cloudflared running in its own container
# should join the sharely Docker network instead (see README).
BIND_ADDRESS=127.0.0.1

# Number of trusted reverse-proxy hops in front of the app, used to read the
# real client IP for rate limits and the audit log.
#   1 = one proxy (nginx on the host, Cloudflare Tunnel)
#   2 = two proxies (e.g. Cloudflare -> nginx)
TRUST_PROXY=1

# MongoDB – docker-compose constructs MONGODB_URI from these automatically
MONGO_ROOT_PASSWORD=change-me-root-password
MONGO_APP_USER=appuser
MONGO_APP_PASSWORD=change-me-app-password
MONGO_DB_NAME=sharely

# Only needed when running without Docker (npm run dev / npm start / scripts):
# MONGODB_URI=mongodb://appuser:change-me-app-password@localhost:27017/sharely?authSource=sharely

# Session secret – generate a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-secret

# Base URL for generated share links (no trailing slash)
BASE_URL=http://localhost:3000

# Site name shown in Open Graph embeds (default: sharely)
SITE_NAME=sharely

# Max upload size in MB for regular uploads (default 100).
# Large files from the web UI use chunked uploads and are not limited by this.
MAX_FILE_SIZE_MB=100

# Allow public registration (true/false)
# When false, only admins can create new users
ALLOW_REGISTRATION=true

# First-run setup token (optional).
# The setup page requires a token to create the first admin account. If left
# empty, a random token is printed to the log on first start:
#   docker compose logs app
INSTALL_TOKEN=

# Encryption of stored files (optional).
# If set, new uploads and thumbnails are stored encrypted (AES-256-GCM).
# Generate once with `openssl rand -base64 32` and BACK IT UP SEPARATELY:
# without this key, encrypted files cannot be recovered. Changing or removing
# it later is not supported. Encrypt files uploaded before setting it with:
#   docker compose exec app npm run migrate:encrypt
ENCRYPTION_KEY=

# Upload directory (optional, only when running without Docker; default ./uploads)
# UPLOAD_DIR=/absolute/path/to/uploads

# SMTP – required for email verification and password reset
# Leave SMTP_HOST blank to disable these features
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to true for port 465 (implicit TLS), false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
# From address shown in emails (defaults to SMTP_USER if not set)
SMTP_FROM=noreply@example.com

# LDAP / directory login (optional)
# When LDAP_URL is set, users can log in with their directory credentials
# (search + bind). Leave LDAP_URL blank to disable LDAP login. Existing local
# accounts always authenticate against their local password first; first-time
# LDAP logins get a local account created automatically.
LDAP_URL=
# Service account used to find the user before the password bind.
# Leave LDAP_BIND_DN blank for an anonymous bind.
LDAP_BIND_DN=cn=readonly,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-bind-password
# Base DN under which users are searched
LDAP_SEARCH_BASE=ou=people,dc=example,dc=com
# Search filter; {{username}} is replaced with the (escaped) login name.
# Active Directory: (sAMAccountName={{username}})
LDAP_SEARCH_FILTER=(uid={{username}})
# Directory attribute read as the user's email address
LDAP_ATTR_EMAIL=mail
# Set to false to accept self-signed / untrusted ldaps:// certificates
LDAP_TLS_REJECT_UNAUTHORIZED=true

# Automatic updates (optional)
# Enable one-click self-update in the admin panel. Also start the updater:
#   docker compose --profile updater up -d --build
# Leave false to keep the panel notification-only.
UPDATE_ENABLED=false
UPDATE_BRANCH=main
# GitHub repo (owner/repo) checked for new releases
UPDATE_REPO=Christianoooooo/sharely
# Compose project name - must match between host and updater
COMPOSE_PROJECT_NAME=sharely
# Update detection mode:
#   release = compare against the latest GitHub release tag
#   branch  = compare installed commit against the branch tip (use this if you
#             deploy by pushing commits instead of creating releases)
UPDATE_CHANNEL=release
