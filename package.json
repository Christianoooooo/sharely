{
  "name": "sharely",
  "version": "1.0.0",
  "description": "Lightweight file manager with ShareX and *NIX support",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node src/utils/validateEmail.test.js && node src/utils/stripMetadata.test.js && node src/utils/fileCrypto.test.js",
    "build": "cd client && npm install && npm run build",
    "migrate:user-folders": "node scripts/migrate-uploads-to-user-folders.js",
    "migrate:thumbnails": "node scripts/generate-missing-thumbnails.js",
    "migrate:encrypt": "node scripts/encrypt-existing-files.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.0",
    "mime-types": "^3.0.2",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "proxy-addr": "^2.0.8",
    "sql.js": "^1.15.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
